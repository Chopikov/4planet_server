# App Configuration
APP_BASE_URL=http://localhost:8080
APP_COOKIE_NAME=session_id
APP_COOKIE_DOMAIN=localhost
APP_COOKIE_SECURE=false
APP_SESSION_TTL=720h

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/planet?sslmode=disable

# SMTP Configuration (optional, uses MailHog in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@4planet.local

# Email Text Configuration
EMAIL_VERIFICATION_SUBJECT=Verify your email address
EMAIL_PASSWORD_RESET_SUBJECT=Reset your password
EMAIL_VERIFY_EMAIL_URL=/verify-email
EMAIL_RESET_PASSWORD_URL=/reset-password
EMAIL_TEAM_NAME=4Planet Team

# CloudPayments Configuration (optional for development)
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_SECRET=

# Payment Text Configuration
PAYMENTS_DEFAULT_DONATION_DESCRIPTION=Tree planting donation
PAYMENTS_BASE_SUBSCRIPTION_DESCRIPTION=tree planting subscription
PAYMENTS_SUBSCRIPTION_MONTHLY_DESCRIPTION=monthly tree planting subscription
PAYMENTS_SUBSCRIPTION_YEARLY_DESCRIPTION=yearly tree planting subscription
PAYMENTS_SUBSCRIPTION_CUSTOM_DESCRIPTION=tree planting subscription

# Logging
LOG_LEVEL=debug

# Admin Interface
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
